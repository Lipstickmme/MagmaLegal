# Copy to `.env` for local development. In production every one of these lives
# in Vercel → Project → Settings → Environment Variables (tick Production and
# Preview), and a change only takes effect after a redeploy.
#
# Open /api/health on the deployment to see which of these the running server
# can actually read. It never prints a value.

# --- Supabase: required for chat, the forms and /admin --------------------
# Supabase dashboard → Project Settings → API.
#
# These two reach the browser at runtime, which is expected: the anon key is
# public by design and row level security decides what it can touch.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security — never give it a VITE_ or
# NEXT_PUBLIC_ prefix, never paste it into client code. It writes enquiries,
# bookings and email rows.
SUPABASE_SERVICE_ROLE_KEY=

# Also accepted, so Vercel's Supabase integration works on its own:
#   URL:          VITE_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
#   anon key:     VITE_SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                 SUPABASE_PUBLISHABLE_KEY (+ the VITE_/NEXT_PUBLIC_ variants)
#   service role: SUPABASE_SECRET_KEY, SERVICE_ROLE_KEY

# --- Resend: sending mail -------------------------------------------------
# Unset means notifications are skipped and logged; nothing else breaks.
RESEND_API_KEY=

# The domain you verified in Resend. Every address below defaults from it, so
# leaving it unset means mail is sent "from" example.com — and Resend rejects it.
MAIL_DOMAIN=magmalegal.com

# Optional overrides. The defaults are shown.
# MAIL_FROM=Magma Legal Practitioners <no-reply@magmalegal.com>
# MAIL_REPLY_TO=hello@magmalegal.com

# Where staff notifications land: a real inbox someone reads. Defaults to
# MAIL_REPLY_TO. If you also receive mail below, do NOT point this at an
# address on MAIL_DOMAIN that routes back into /api/inbound-email — it loops.
# MAIL_NOTIFY_TO=you@yourfirm.com

# --- Resend: receiving mail (optional) ------------------------------------
# The whsec_… signing secret of the Resend inbound webhook pointed at
# https://<your-site>/api/inbound-email. Needs 0002_email.sql applied.
RESEND_WEBHOOK_SECRET=
